<template>
  <view class="app-container">
    <!-- 接码邮箱区域 -->
    <view class="card">
      <text class="card-title">接码邮箱</text>
      <view class="email-display" v-if="state.emailAddress">
        <text class="email-text">{{ state.emailAddress }}</text>
      </view>
      <view class="button-group">
        <button class="neo-button" @click="copyText(state.emailAddress)">点击复制邮箱</button>
        <button class="neo-button" @click="generateSub">随机生成邮箱</button>
        <button class="neo-button" @click="switchEmail">切换指定邮箱</button>
      </view>
    </view>

    <!-- 验证码区域 -->
    <view class="card" v-if="state.emailData.message_not_read">
      <text class="card-title">实时邮件 - {{formatTimeAgoFromUnix(state.emailData.message_not_read.create_time)}}</text>
      <view class="code-box" id="code-text">
        <text class="code-text" style="word-break: break-all">{{ state.emailData.message_not_read.code }}</text>
      </view>
      <button v-if="state.emailData.message_not_read.code" class="neo-button"
              @click="copyText(state.emailData.message_not_read.code)">点击复制验证码
      </button>
      <view class="info-box">
        <text style="word-break: break-all">
          {{ cheerioLoad(state.emailData.message_not_read.content).text().replace(/\s+/g, ' ').trim() }}
        </text>
      </view>

    </view>

  </view>
</template>


<script setup>
import {reactive,ref} from 'vue'
import {onLoad, onShow, onReady, onUnload} from '@dcloudio/uni-app'
import {index, generate, check} from "../../api";
import {load as cheerioLoad} from 'cheerio'

const state = reactive({
  emailAddress: '',
  emailData: {}
})

const storeEmail = {
  set(email) {
    uni.setStorageSync('email', email)
  },
  get() {
    return uni.getStorageSync('email')
  },
  remove() {
    uni.removeStorageSync('email')
  }
}

const loadEmail = () => {
  return index({email: storeEmail.get()}).then(res => {
      if (res.code === 1) {
        state.emailData = res.data
        if (res.data.address) {
          state.emailAddress = res.data.address
          storeEmail.set(res.data.address)

        }
      }

    // console.log(res)
  })
}

let timer = ref();

const initTaskLoadEmail = () => {
  const task = () => {
    timer.value = setTimeout(async () => {
      try{
        await loadEmail()
      }catch (e){}
      task()
    }, 2000)
  }

  task();
}

const copyText = (text) => {
/*  function copyText() {
    const text = document.getElementById("text").innerText;
    navigator.clipboard.writeText(text).then(() => {
      alert("复制成功！");
    }).catch(err => {
      alert("复制失败：" + err);
    });
  } */

  uni.setClipboardData({
    data: text,
    success: () => {
      uni.showToast({
        title: '复制成功',
        icon: 'success'
      });
    },
    fail: () => {
      uni.showToast({
        title: '复制失败',
        icon: 'none'
      });
    }
  });
}


const generateSub = () => {

  return new Promise((resolve, reject) => {

    const handle = () => {
      uni.showLoading()
      generate().then(res => {
        if (res.code === 1) {
          uni.showToast({title: '生成成功'})
          storeEmail.set(res.data.email)
          loadEmail()
          resolve(res.data.email)
        } else {
          reject()
          uni.showToast({title: res.msg, icon: 'none'})
        }
      }).finally(() => {
        uni.hideLoading()
      })
    }

    if (state.emailData.message_not_read) {
      handle()
      return
    }
    uni.showModal({
      content: '你当前没有收到邮件，确认要重新生成邮箱？',
      title: '确认操作', success: (res) => {

        if (res.confirm) {
          handle()
        }

      }
    })
  })
}

const switchEmail = () => {
  uni.showModal({
    title: '切换邮箱',
    content:  state.emailAddress,
    placeholderText: '输入要切换的指定邮箱地址',
    editable:true,
    success: (e) => {
      if (e.confirm){
        uni.showLoading()
        check(  e.content).then((res)=>{
          if (res.code === 1) {
            storeEmail.set(e.content)
            loadEmail()
            uni.showToast({title: "已切换到："+e.content,  icon: 'none'})
          }else{
            uni.showToast({title: "切換的邮箱不存在", icon: 'none'})
          }
        }).finally(() => {
          uni.hideLoading()
        })
      }
    }
  })
}
function formatTimeAgoFromUnix(unixTime) {
  const now = Date.now(); // 当前时间（毫秒）
  const isSecond = String(unixTime).length === 10;
  const timeMs = isSecond ? unixTime * 1000 : unixTime;
  const diff = Math.floor((now - timeMs) / 1000); // 差值（秒）

  if (diff < 10) return '刚刚';
  if (diff < 60) return `${diff} 秒前`;
  if (diff < 3600) return `${Math.floor(diff / 60)} 分钟前`;
  if (diff < 86400) return `${Math.floor(diff / 3600)} 小时前`;

   return `${Math.floor(diff / 86400)} 天前`;

}

onLoad(async () => {

  await loadEmail()
  initTaskLoadEmail();

})
onShow(async () => {


})


</script>
